      "components": [
        {
          "name": "tfrTaV",
          "options": {
            "customValidationMessages": {
              "any.required": "Select yes if this address has been tested before using a gas test kit purchased from us"
            }
          },
          "type": "YesNoField",
          "title": "Have you tested this address before using a gas test kit purchaced from us?",
          "schema": {},
          "values": { "type": "listRef" }
        }
      ],
      "next": [
        {
          "path": "/was-the-level-above-the-action-level-200-bqm-3",
          "condition": "jCTvKA"
        },
        {
          "path": "/enter-your-personal-details-placeholder",
          "condition": "KTPJJd"
        }
      ]
    },
    {
      "path": "/was-the-level-above-the-action-level-200-bqm-3",
      "title": "Was the level above the action level 200 Bq m⁻³",
      "components": [
        {
          "name": "vLGkYq",
          "options": {
            "customValidationMessages": {
              "any.required": "Select yes if the level was above the action level of 200 Bq m⁻³"
            }
          },
          "type": "YesNoField",
          "title": "Was the level above the action level 200 Bq m⁻³",
          "schema": {}
        }
      ],
      "next": [
        {
          "path": "/have-you-taken-any-steps-to-reduce-the-radon-level-since-the-last-test",
          "condition": "yYdSeb"
        },
        {
          "path": "/enter-your-personal-details-placeholder",
          "condition": "sxYJjS"
        }
      ]
    },
    {
      "path": "/have-you-taken-any-steps-to-reduce-the-radon-level-since-the-last-test",
      "title": "Have you taken any steps to reduce the radon level since the last test?",
      "components": [
        {
          "name": "XOXigN",
          "options": {
            "customValidationMessages": {
              "any.required": "Select yes if you have taken steps to reduce the radon level since the last test"
            }
          },
          "type": "YesNoField",
          "title": "Have you taken any steps to reduce the radon level since the last test?",
          "schema": {}
        }
      ],
      "next": [
        {
          "path": "/you-may-be-eligible-for-a-free-test",
          "condition": "cHAkee"
        },
        {
          "path": "/enter-your-personal-details-placeholder",
          "condition": "mUgnbI"
        }
      ]
    },
    {
      "path": "/you-may-be-eligible-for-a-free-test",
      "title": "You may be eligible for a free test",
      "components": [
        {
          "name": "yuiyLN",
          "options": {},
          "type": "Para",
          "content": "Contact the Radon team on 01235 822622 to find out.",
          "schema": {}
        },
        {
          "name": "EoUUVB",
          "options": {},
          "type": "Para",
          "content": "<a href=\"enter-your-personal-details-placeholder\" target=\"_blank\">Continue without a free retest</a>",
          "schema": {}
        }
      ],
      "next": []
    },
    {
      "path": "/enter-your-personal-details-placeholder",
      "title": "Enter your personal details placeholder",
      "components": [],
      "next": [{ "path": "/summary" }]
    },
    {
      "title": "Summary",
      "path": "/summary",
      "controller": "./pages/summary.js",
      "components": [],
      "next": []
    }
  ],
  "lists": [
    {
      "title": "The test will not be valid if:",
      "name": "wnGWzk",
      "type": "string",
      "items": [
        {
          "text": "any building work is planned during the testing period that disrupts normal living conditions, or changes the way air moves through the property",
          "value": "any building work is planned during the testing period that disrupts normal living conditions, or changes the way air moves through the property"
        },
        {
          "text": "the property is empty for more than 2 weeks during the test",
